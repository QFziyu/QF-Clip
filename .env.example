OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# 每次网络等待上限；超时重试时逐步增加，封顶 OPENAI_MAX_TIMEOUT。
OPENAI_TIMEOUT=180
OPENAI_MAX_TIMEOUT=600
WHISPER_MODEL=medium
# faster_whisper：原本的本地 Whisper；zipformer_http：独立中文 CPU 服务。
# 网页「设置」保存到 .env.asr，优先于此文件；均不调用云端 ASR。
ASR_ENGINE=faster_whisper
LOCAL_ASR_URL=http://127.0.0.1:8765
# 可选 LLM 文字校对，与语音识别和选片独立。
SUBTITLE_REVIEW_ENABLED=false
DEVICE=cpu
COMPUTE_TYPE=int8
OUTPUT_DIR=./output
CACHE_DIR=./cache
# Windows 完整路径可包含中文和空格，不要添加命令行参数。
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 两种来源：api / codex_cli。网页设置保存到 .env.llm，优先于以上设置。
FCF_LLM_PROVIDER=api
OPENAI_REASONING_EFFORT=default
CODEX_CLI_PATH=
FCF_CODEX_HOME=
CODEX_MODEL=
CODEX_REASONING_EFFORT=default
